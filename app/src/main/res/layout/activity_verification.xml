<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!--lena 3malna el layout el matloub fel pdf 30/70 horizontal-->
    <ImageView
        android:id="@+id/img_passport_AT"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="#142B4A"
        android:contentDescription="Passport image"
        android:scaleType="centerInside"
        app:srcCompat="@android:drawable/ic_menu_compass" />
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="16dp">


        <TextView
            android:id="@+id/txt_verification_AT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPORAL PASSPORT"
            android:textColor="#142B4A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_nom_verif_AT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_verification_AT"
            android:layout_marginTop="25dp"
            android:text="Traveler:"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txt_age_verif_AT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_nom_verif_AT"
            android:layout_marginTop="15dp"
            android:text="Temporal age:" />
        <TextView
            android:id="@+id/txt_motif_verif_AT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_age_verif_AT"
            android:layout_marginTop="15dp"
            android:text="Reason:" />

        <Button
            android:id="@+id/btn_approve_AT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="65dp"
            android:text="Approve" />

        <Button
            android:id="@+id/btn_refuse_AT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Refuse" />
    </RelativeLayout>
</LinearLayout>